# ── Auth (required) ──────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
#                          http://localhost:3000/api/auth/callback/google (dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Only accounts on this Google Workspace domain may sign in
ALLOWED_EMAIL_DOMAIN=co.vet

# ── Roles (comma-separated emails) ───────────────────────────────
# Anyone on ALLOWED_EMAIL_DOMAIN gets in as "qa" with no approval step.
# These three lists are the whole permission model — no database.
# Admins additionally see the Access page.
QA_ADMIN_EMAILS=clezama@co.vet
# Demoted to viewer: signed in, but no Manual Testing / Automation.
QA_VIEWER_EMAILS=
# Refused at sign-in, even on the allowed domain.
QA_BLOCKED_EMAILS=
# Legacy, kept for documentation; the domain now grants "qa" on its own.
QA_TEAM_EMAILS=

# ── Sign-in notifications ────────────────────────────────────────
# Emailed here whenever somebody signs in (no approval to give — they
# are already in).
NOTIFY_EMAIL=clezama@co.vet
# Resend (https://resend.com) API key. Without it, emails are logged
# to the server console instead of sent.
RESEND_API_KEY=
# Verified sender. Resend's onboarding address works out of the box.
EMAIL_FROM=QA Hub <onboarding@resend.dev>
# Public base URL used in email links (set to the Vercel domain in prod).
APP_URL=http://localhost:3000

# ── Linear (optional — a workspace snapshot is shown until set) ──
# Linear → Settings → Security & access → Personal API keys.
# Powers the QA Roadmap (tickets per release + coverage check).
LINEAR_API_KEY=
# Labels that put a Linear ticket on the QA roadmap.
QA_ROADMAP_LABELS=Medium to Big Size Features,Quick wins
# Tickets with any of these labels are excluded (QA's own process tickets).
QA_ROADMAP_EXCLUDE_LABELS=qa
# Linear labels that mark bugs for the Bugs / CS Bugs pages.
QA_BUG_LABEL=Bug
QA_CS_BUG_LABEL=CS Bug

# ── Testiny (optional — sample data is shown until set) ──────────
# Testiny → Account Settings → API Keys
TESTINY_API_KEY=
# Numeric id of the Testiny project to read (QA CoVet = 1)
TESTINY_PROJECT_ID=1
